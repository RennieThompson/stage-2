# Environment variables for The Beauty Bar.
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# Names only. No values live in git.

# ---------------------------------------------------------------- public ----
# Safe to expose to the browser. Only these two may use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public site origin, used for links in emails.
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------- server-only ----
# Server-only. Only use these in files that `import "server-only"`.
# Supabase secret key. Used for the place-order RPC and email logs only.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------- email ----
# Mailgun HTTP API. Server-only.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=